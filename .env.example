# =============================================================================
# Project AURA - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Application ---
APP_NAME=project-aura
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-secure-random-secret
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_USER=aura
POSTGRES_PASSWORD=change-me-securely
POSTGRES_DB=aura_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aura:change-me-securely@postgres:5432/aura_db

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# --- IICS (internet overlay) ---
# Comma-separated allowlisted advisory feeds. Empty disables polling.
# Default uses the public NVD 2.0 API with a small page size.
IICS_THREAT_FEEDS=https://services.nvd.nist.gov/rest/json/cves/2.0?resultsPerPage=20
IICS_THREAT_FEED_INTERVAL_MINUTES=360
IICS_SITE_POLICY_REFRESH_MINUTES=720

# --- LiteLLM (Model Gateway) ---
LITELLM_HOST=0.0.0.0
LITELLM_PORT=4000
LITELLM_MASTER_KEY=change-me-securely
# Set once and keep stable: rotates encrypted provider credentials in LiteLLM's DB.
LITELLM_SALT_KEY=change-me-salt-key
# OD-54 model catalogue (metadata source; availability is checked separately)
MODELS_DEV_API_URL=https://models.dev/api.json?type=all
# Provider API keys (set only the ones you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Qwen / Alibaba (hosted or self-served)
DASHSCOPE_API_KEY=
# NVIDIA NIM / build.nvidia.com (free endpoints for prototyping)
# NVIDIA_API_KEY is the original single-key fallback. For multiple free-tier
# keys, set NVIDIA_API_KEY_1..4; each becomes a separate LiteLLM deployment
# behind the same model alias. Leave unused keys blank.
NVIDIA_API_KEY=
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_FREE_ONLY=true
# Free models only by default — paid aliases are refused even with a signature.
FREE_MODELS_ONLY=true
# Search API providers (optional). GOOGLE_API_KEY also serves the gated
# Gemini provider template (OD-38) when enabled in infra/litellm/config.yaml.
BRAVE_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CX=
# Live information (proposed Doc 34). Browser stays off globally; it is used
# only when a triggered live request has no suitable evidence. Paid search is
# never called automatically.
IAM_LIVE_INFO_ENABLED=true
IAM_LIVE_INFO_MAX_RESULTS=3
IAM_LIVE_INFO_TIMEOUT_SECONDS=20
IAM_LIVE_INFO_USE_BROWSER=false
IAM_LIVE_INFO_ESCALATE_TO_BROWSER=true
# Search provider chain (free-first). Paid providers need signed authorisation.
IAM_SEARCH_PROVIDER_ORDER=wikipedia,duckduckgo,searxng
IAM_SEARCH_SEARXNG_URL=
IAM_SEARCH_TAVILY_API_KEY=
# Ollama local models - OD-38 reopened 25 Nov: only qwen2.5:3b
# Set OLLAMA_ENABLED=true only after pulling a model:
#   docker exec aura-ollama ollama pull qwen2.5:3b
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434

# Optional hardware-backed attestation (requires TPM 2.0 + tpm2-tools or sysfs)
TPM_MEASUREMENT_ENABLED=false

# Official assistant integration endpoints (URLs only — never store credentials here)
ALEXA_SKILL_ENDPOINT=
SIRI_INTENTS_ENDPOINT=
BIXBY_AUTOMATION_ENDPOINT=
# Local-only semantic memory embeddings (free). Omit the tag to use keyword recall.
MEMORY_EMBEDDING_PROVIDER=local
MEMORY_EMBEDDING_MODEL=nomic-embed-text
# Shared primary model for the frontend and backend. Omit `model` in chat
# requests and IAM uses this. Hosted models remain optional sub-agents and
# must be requested explicitly. See IAM_FOUNDATION_MODEL_AND_INTELLIGENCE_SPEC.md.
IAM_PRIMARY_MODEL=local-qwen-3b
IAM_PRIMARY_LOCAL_TAG=qwen2.5:3b
# Generous inference timeouts for cache-cold local model loads (seconds).
INFERENCE_CHAT_TIMEOUT_SECONDS=300
INFERENCE_STREAM_TIMEOUT_SECONDS=300
# IRWM runtime enforcement (OD-39) — one resident model, one request.
IRWM_ENABLED=true
IRWM_HARD_CEILING_MB=6000
IRWM_TARGET_LOADED_RAM_MB=5500
IRWM_KEEP_ALIVE_SECONDS=120
IRWM_MAX_CONCURRENT=1
IRWM_CONTEXT_TOKENS=4096

# --- Object Storage (S3-compatible) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=aura-storage
S3_REGION=us-east-1

# --- Browser Automation ---
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# --- Media services ---
VOICE_TTS_URL=
VOICE_TTS_API_KEY=
VOICE_VAD_SAMPLE_RATE=16000
VOICE_VAD_THRESHOLD=0.02
VISION_FFMPEG_PATH=ffmpeg
VISION_MODEL=qwen3.5-9b
# UWAIE browser automation — Playwright engine and bounded file-transfer root.
UWAI_BROWSER_ENGINE=chromium
UWAI_UPLOAD_ROOT=
UWAI_COMPUTER_USE_ENABLED=false
# Mobile agent — fail-closed unless enabled and device serial is allowed.
MOBILE_AGENT_ENABLED=false
MOBILE_ADB_PATH=adb
MOBILE_ALLOWED_DEVICES=

# --- Skill Runtime ---
SKILL_RUNTIME_ENABLED=false
# stub executes nothing (simulation only); docker is the real restricted adapter.
SKILL_RUNTIME_ADAPTER=stub
SKILL_RUNTIME_IMAGE=python:3.12-alpine
SKILL_RUNTIME_TIMEOUT_SECONDS=30
SKILL_RUNTIME_MEMORY=256m
SKILL_RUNTIME_CPUS=0.5
SKILL_RUNTIME_PER_SKILL_LIMIT_PER_MINUTE=60
SKILL_RUNTIME_MAX_LOG_CHARS=200000
SKILL_RUNTIME_AUDIT_LOG_CHUNK_CHARS=32000
# Explicit opt-in for skills whose published permission manifest includes
# network_access. The named Docker network must already exist and must have
# restricted egress (operator-managed firewall/proxy). 'host'/'bridge'/'none'
# are rejected.
SKILL_RUNTIME_NETWORK_ENABLED=false
SKILL_RUNTIME_NETWORK_NAME=

# --- Workspace manager (WS-01/WS-02) ---
WORKSPACE_ENABLED=false
WORKSPACE_ADAPTER=stub
WORKSPACE_ROOT=
WORKSPACE_IMAGE=python:3.12-alpine
WORKSPACE_TIMEOUT_SECONDS=60
WORKSPACE_MEMORY=512m
WORKSPACE_CPUS=1.0
# Provider order; 'local' is always the final fallback if an online provider
# disappears or has no credentials configured.
WORKSPACE_PROVIDERS=local,coder,codespaces
WORKSPACE_CODER_URL=
WORKSPACE_CODER_TOKEN_ENV=WORKSPACE_CODER_TOKEN
WORKSPACE_CODESPACES_REPO=
WORKSPACE_CODESPACES_TOKEN_ENV=WORKSPACE_CODESPACES_TOKEN
WORKSPACE_CREDENTIAL_TTL_SECONDS=3600
# Remote providers are fail-closed. Enable only after the token env var and
# execute-path bridge (if command execution is needed) are configured.
WORKSPACE_REMOTE_EXECUTION_ENABLED=false
WORKSPACE_REMOTE_TIMEOUT_SECONDS=30
WORKSPACE_CODER_TEMPLATE_ID=
WORKSPACE_CODER_CREATE_PATH=/api/v2/users/me/workspaces
WORKSPACE_CODER_START_PATH=/api/v2/users/me/workspaces/{id}/start
WORKSPACE_CODER_DESTROY_PATH=/api/v2/users/me/workspaces/{id}
WORKSPACE_CODER_EXECUTE_PATH=
WORKSPACE_CODESPACES_API_BASE=https://api.github.com
WORKSPACE_CODESPACES_REF=main
WORKSPACE_CODESPACES_CREATE_PATH=/repos/{repo}/codespaces
WORKSPACE_CODESPACES_START_PATH=/repos/{repo}/codespaces/{id}/start
WORKSPACE_CODESPACES_DESTROY_PATH=/repos/{repo}/codespaces/{id}
WORKSPACE_CODESPACES_EXECUTE_PATH=
MODEL_RELEASE_ARTIFACT_ROOT=
# Durable research artifacts: local (default) or s3 (MinIO/S3).
RESEARCH_ARTIFACT_STORE=local
RESEARCH_ARTIFACT_PREFIX=research
# Optional agent-side MCP bridge for real Colab drivers (human sign-in required).
COLAB_MCP_ENABLED=false
COLAB_MCP_BRIDGE_URL=
COLAB_MCP_BRIDGE_TOKEN=
# Trusted local evaluator; empty path disables benchmark evidence.
LM_EVAL_DATASET_PATH=app/services/ai_research/eval_sets/basic.jsonl
# Post-deploy regression monitoring; rollback still needs signed authorization.
POST_DEPLOY_MONITOR_ENABLED=false
POST_DEPLOY_AUTO_ROLLBACK_ENABLED=false
POST_DEPLOY_REGRESSION_THRESHOLD=0.05
# OD-04 zero standing budget — hard caps at the spend path.
FINANCE_MONTHLY_LIMIT_USD=100
FINANCE_TRANSACTION_LIMIT_USD=10
# OD-23 blockchain — free tier and testnets only.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_PROVIDER=thirdweb
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_CLIENT_ID_ENV=THIRDWEB_CLIENT_ID
BLOCKCHAIN_SECRET_ENV=THIRDWEB_SECRET_KEY
BLOCKCHAIN_ALLOW_MAINNET=false
# OD-24 banking — env-var names only, never secret values.
BANKING_ENABLED=false
BANKING_ADAPTER=stub
BANKING_BASE_URL=
BANKING_TOKEN_ENV=BANKING_TOKEN
BANKING_COUNTRY=ZA
# Doc 25 paper trading — simulation only.
TRADING_SIMULATION_ENABLED=false
TRADING_MAX_ORDER_USD=10
TRADING_DAILY_EXPOSURE_USD=100
TRADING_MAX_LOSS_USD=20
TRADING_STOP_LOSS_PCT=10

# --- API authentication ---
IAM_PROTOCOL_VERSION=1
IAM_PROTOCOL_REQUIRE_HEADER=false
AUTH_ENABLED=true
IAM_BOOTSTRAP_API_KEY=
AUTH_RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BACKEND=memory

# Use X-API-Key or Authorization: Bearer with a key created at /api/v1/auth/bootstrap

# --- Creator approval and communication by email (OD-18/OD-19) ---
# Email is the carrier; authority comes from a signed challenge.
# The same transport delivers approval requests and IAM's informational
# questions/status updates (/api/v1/creator/messages). A plain reply never
# authorises anything. CREATOR_EMAIL and CREATOR_PUBLIC_KEY must be set before
# IAM can ask the Creator; the default "log" transport records without sending.
CREATOR_EMAIL=
CREATOR_EMAIL_DOMAIN=
# ED25519 public key (PEM or base64 raw) of the external Creator signer
CREATOR_PUBLIC_KEY=
CREATOR_SIGNER_ID=creator-hardware-signer
CREATOR_CHALLENGE_TTL_SECONDS=3600
CREATOR_AUTHORIZATION_TTL_SECONDS=3600
# log (default, sends nothing) | smtp | http
CREATOR_EMAIL_TRANSPORT=log
CREATOR_EMAIL_FROM=
CREATOR_SMTP_HOST=
CREATOR_SMTP_PORT=587
CREATOR_SMTP_USER=
CREATOR_SMTP_PASSWORD=
CREATOR_EMAIL_HTTP_URL=
CREATOR_EMAIL_HTTP_TOKEN=
# HMAC secret for the inbound signed-decision gateway; empty disables it
CREATOR_GATEWAY_SECRET=

# --- Frontend server-side proxy (read-only internal views) ---
# Server-only IAM credential used by /iam-proxy/* (tone + AI network views).
# Must be an admin-scoped key: /api/v1/network requires admin scope.
# Never expose this as NEXT_PUBLIC_* — the browser must not hold it.
IAM_PROXY_TOKEN=
CREATOR_EMAIL_WORKER_ENABLED=true
CREATOR_EMAIL_RETRY_INTERVAL_SECONDS=300
CREATOR_EMAIL_MAX_ATTEMPTS=5
CREATOR_ALERT_WEBHOOK_URL=

# --- P2P node identity (OD-12/OD-26) ---
# Stable node id and shared signing secret for /api/v1/p2p/ws/{peer_id}.
# Without IAM_P2P_SECRET a random secret is generated at each start and peers
# cannot reconnect after a restart. Use a header (X-Peer-Secret) rather than the
# URL query where possible.
IAM_NODE_ID=local-iam
IAM_P2P_SECRET=

# --- API authentication (OD-29 SDK / CLI / acceptance tests) ---
# Set this to create the first credential via POST /api/v1/auth/bootstrap
# with header X-Bootstrap-Key. Leave empty to disable bootstrapping.
IAM_BOOTSTRAP_API_KEY=
# After bootstrapping, export the returned key for live-stack acceptance tests:
#   export IAM_API_KEY=<key returned once by /auth/bootstrap>
# AUTH_ENABLED=true

# --- Security ---
ENCRYPTION_KEY=change-me-to-a-32-byte-base64-key
SESSION_SECRET=change-me-session-secret

# --- Doc 25 Amendment A — research-only financial intelligence ---
# All flags default-off. No wagering, wallet funding or real order execution.
PREDICTION_MARKETS_RESEARCH_ENABLED=false
PREDICTION_MARKETS_DATA_ADAPTER_ENABLED=false
# Public-data base URLs are empty until an operator reviews the provider.
PREDICTION_MARKETS_GAMMA_URL=
PREDICTION_MARKETS_CLOB_URL=
PREDICTION_MARKETS_DATA_URL=
PREDICTION_MARKETS_REQUEST_TIMEOUT_SECONDS=10
PREDICTION_MARKETS_MAX_MARKETS=20
PREDICTION_MARKETS_BOOK_DEPTH=5
PREDICTION_MARKETS_FORECASTING_ENABLED=false
GAMING_INTELLIGENCE_ENABLED=false
INVESTMENT_INTELLIGENCE_RESEARCH_ENABLED=false
FINANCIAL_PROVIDER_REGISTRY_ENABLED=false

# --- Monitoring ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
